        {"position": 2, "item_body": "<p>The whole history of the project as it was when you cloned it</p>"},
        {"position": 3, "item_body": "<p>Only the latest version; earlier commits are fetched from GitHub when needed</p>"},
        {"position": 4, "item_body": "<p>Only the commits you have made yourself on the laptop</p>"}
